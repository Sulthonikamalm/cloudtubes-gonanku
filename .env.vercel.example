# Copy values into Vercel Project Settings > Environment Variables.
# Never commit real secrets.

APP_NAME=Gonanku
APP_ENV=production
SECRET_KEY=ganti_dengan_random_secret_minimal_32_karakter

# Supabase PostgreSQL pooler URL. Vercel tidak memakai SQLite persisten.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

TELEGRAM_BOT_TOKEN=isi_token_botfather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

GROQ_API_KEY=isi_api_key_groq_1
GROQ_API_KEY_2=isi_api_key_groq_2
GROQ_API_KEY_3=isi_api_key_groq_3
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_AUDIO=

# Vercel Function request body limit is 4.5 MB; keep buffer below it.
MAX_UPLOAD_MB=4
AI_TEXT_LIMIT=4000
BATAS_UPLOAD_FOTO=15
BATAS_UPLOAD_DOKUMEN=10
