APP_NAME=Gonanku
APP_ENV=development
SECRET_KEY=ganti_dengan_secret_lokal

# Lokal contoh: postgresql://user:password@localhost:5432/gonanku
# Kosongkan untuk memakai SQLite lokal saat pengembangan awal.
DATABASE_URL=

TELEGRAM_BOT_TOKEN=isi_token_bot
TELEGRAM_CHAT_ID=isi_chat_id_private_channel

# Tiga API key Groq (pembagian tugas + failover saat limit harian).
# Key 1 -> metadata teks dokumen.
# Key 2 -> chatbot (intent + jawaban).
# Key 3 -> vision (image-to-text foto/screenshot).
GROQ_API_KEY=isi_api_key_groq_1
GROQ_API_KEY_2=isi_api_key_groq_2
GROQ_API_KEY_3=isi_api_key_groq_3
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=sesuaikan_model_vision
GROQ_MODEL_AUDIO=sesuaikan_model_audio

MAX_UPLOAD_MB=50
AI_TEXT_LIMIT=4000
