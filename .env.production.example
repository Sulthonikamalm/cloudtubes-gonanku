# ============================================================
# Gonanku - Production Env Var Template
# ============================================================
# CARA PAKAI:
#   1. Copy file ini menjadi .env.production (TIDAK di-commit, lihat .gitignore).
#   2. Isi semua nilai sesuai akun kamu.
#   3. deploy.ps1 / deploy.sh akan membaca file ini dan inject ke Cloud Run.
# ============================================================

# --- App ---
APP_NAME=Gonanku
APP_ENV=production
# Generate ulang dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_64_char_random

# --- Database: Supabase (Connection Pooling / Transaction mode) ---
# Format: postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
# sslmode=require akan ditambahkan otomatis oleh config.py kalau lupa.
DATABASE_URL=postgresql://postgres.refxxxxx:SUPABASE_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Telegram ---
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# --- Groq AI (3+ key dengan pembagian tugas + failover) ---
GROQ_API_KEY=gsk_metadata
GROQ_API_KEY_2=gsk_chatbot
GROQ_API_KEY_3=gsk_vision
GROQ_API_KEY_4=
GROQ_API_KEY_5=

GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# --- Batas operasional ---
MAX_UPLOAD_MB=50
AI_TEXT_LIMIT=4000
BATAS_UPLOAD_FOTO=15
BATAS_UPLOAD_DOKUMEN=10
